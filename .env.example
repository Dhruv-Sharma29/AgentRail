# Local Docker Compose configuration. Prefer: python3 scripts/init-local.py
# The initializer generates unique passwords without printing or overwriting them.
DATABASE_PASSWORD=
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
WEB_PORT=8090
# DATABASE_NAME=agentflow

# Optional GitHub Issues connector (disabled by default). Token stays server-side.
AGENTFLOW_GITHUB_ENABLED=false
AGENTFLOW_GITHUB_REPOSITORY=Dhruv-Sharma29/test
GITHUB_TOKEN=
